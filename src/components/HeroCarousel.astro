---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	immagini: { src: string | ImageMetadata; alt: string }[];
	class?: string;
	frecce?: boolean;
}

const { immagini, class: className, frecce = true } = Astro.props;
---

<div class:list={['carosello-hero relative isolate overflow-hidden', className]}>
	{
		immagini.map((img, i) =>
			typeof img.src === 'string' ? (
				<img
					src={img.src}
					alt={img.alt}
					loading={i === 0 ? 'eager' : 'lazy'}
					class:list={['carosello-slide absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
				/>
			) : (
				<Image
					src={img.src}
					alt={img.alt}
					loading={i === 0 ? 'eager' : 'lazy'}
					format="webp"
					class:list={['carosello-slide absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
				/>
			),
		)
	}

	{
		immagini.length > 1 && (
			<div class="carosello-pallini pointer-events-auto absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 gap-2 sm:bottom-8">
				{immagini.map((img, i) => (
					<button
						type="button"
						class:list={['carosello-pallino h-1.5 w-1.5 rounded-full bg-cream/50 transition-all duration-300', i === 0 && 'is-active']}
						data-indice={i}
						aria-label={`Vai all'immagine ${i + 1}`}
					/>
				))}
			</div>
		)
	}

	{
		frecce && immagini.length > 1 && (
			<>
				<button
					type="button"
					class="carosello-freccia carosello-freccia-prec pointer-events-auto absolute top-1/2 left-3 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-ink/35 text-cream backdrop-blur transition-colors hover:bg-ink/55 sm:left-5 sm:h-11 sm:w-11"
					aria-label="Immagine precedente"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor">
						<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 010 1.06L9.06 10l3.73 3.71a.75.75 0 11-1.06 1.06l-4.25-4.25a.75.75 0 010-1.06l4.25-4.25a.75.75 0 011.06 0z" clip-rule="evenodd" />
					</svg>
				</button>
				<button
					type="button"
					class="carosello-freccia carosello-freccia-succ pointer-events-auto absolute top-1/2 right-3 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-ink/35 text-cream backdrop-blur transition-colors hover:bg-ink/55 sm:right-5 sm:h-11 sm:w-11"
					aria-label="Immagine successiva"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor">
						<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01-.02-1.06L10.92 10 7.19 6.29a.75.75 0 111.06-1.06l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.04.02z" clip-rule="evenodd" />
					</svg>
				</button>
			</>
		)
	}
</div>

<style>
	.carosello-slide {
		opacity: 0;
		transform: scale(1.04);
		transition:
			opacity 1.6s ease,
			transform 7s ease-out;
	}
	.carosello-slide.is-active {
		opacity: 1;
		transform: scale(1);
		z-index: 1;
	}
	.carosello-pallino.is-active {
		width: 1.5rem;
		background-color: var(--color-cream);
	}
	@media (prefers-reduced-motion: reduce) {
		.carosello-slide {
			transition: none;
			transform: none;
		}
	}
</style>

<script>
	(function () {
		const riduciMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		document.querySelectorAll('.carosello-hero').forEach((carosello) => {
			const slide = Array.from(carosello.querySelectorAll('.carosello-slide'));
			const pallini = Array.from(carosello.querySelectorAll('.carosello-pallino'));
			const frecciaPrec = carosello.querySelector('.carosello-freccia-prec');
			const frecciaSucc = carosello.querySelector('.carosello-freccia-succ');
			if (slide.length < 2) return;

			let indiceAttivo = 0;
			let timer;

			function vai(indice) {
				slide[indiceAttivo].classList.remove('is-active');
				pallini[indiceAttivo]?.classList.remove('is-active');
				indiceAttivo = indice;
				slide[indiceAttivo].classList.add('is-active');
				pallini[indiceAttivo]?.classList.add('is-active');
			}

			function avanti() {
				vai((indiceAttivo + 1) % slide.length);
			}

			function indietro() {
				vai((indiceAttivo - 1 + slide.length) % slide.length);
			}

			function avvia() {
				ferma();
				timer = window.setInterval(avanti, 5000);
			}

			function ferma() {
				if (timer) window.clearInterval(timer);
			}

			pallini.forEach((pallino, i) => {
				pallino.addEventListener('click', () => {
					vai(i);
					if (!riduciMovimento) avvia();
				});
			});

			frecciaPrec?.addEventListener('click', () => {
				indietro();
				if (!riduciMovimento) avvia();
			});
			frecciaSucc?.addEventListener('click', () => {
				avanti();
				if (!riduciMovimento) avvia();
			});

			if (riduciMovimento) return;

			avvia();
			carosello.addEventListener('mouseenter', ferma);
			carosello.addEventListener('mouseleave', avvia);
		});
	})();
</script>
