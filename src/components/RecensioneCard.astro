---
import type { CollectionEntry } from 'astro:content';

interface Props {
	recensione: CollectionEntry<'recensioni'>;
}

const { recensione } = Astro.props;
const { nome, testo } = recensione.data;
---

<div class="flex flex-col rounded-[1.75rem] bg-sand p-8">
	<p class="text-clay-dark tracking-[0.2em]">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
	<p class="mt-4.5 font-heading text-[21px] leading-snug text-ink">{testo}</p>
	<p class="mt-auto pt-5 text-sm text-faint">{nome}</p>
</div>
