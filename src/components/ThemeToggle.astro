---
import type { Lingua } from '../i18n/utils';
import { traduzioni } from '../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);
---

<button
	id="theme-toggle"
	type="button"
	aria-label={t.temaToggle}
	class="flex shrink-0 items-center justify-center text-stone-600 transition-colors hover:text-amber-800 dark:text-stone-300 dark:hover:text-amber-500"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		class="h-6 w-6 dark:hidden"
	>
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5M12 19.5V21M21 12h-1.5M4.5 12H3M18.4 5.6l-1.06 1.06M6.66 17.34l-1.06 1.06M18.4 18.4l-1.06-1.06M6.66 6.66 5.6 5.6" />
		<circle cx="12" cy="12" r="4.5" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hidden h-6 w-6 dark:block">
		<path
			d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z"
		/>
	</svg>
</button>

<script is:inline>
	(function () {
		var bottone = document.getElementById('theme-toggle');
		if (!bottone) return;
		bottone.addEventListener('click', function () {
			var scuro = document.documentElement.classList.toggle('dark');
			localStorage.setItem('tema', scuro ? 'scuro' : 'chiaro');
		});
	})();
</script>
