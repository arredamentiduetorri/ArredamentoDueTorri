---
import { getEntry } from 'astro:content';
import type { Lingua } from '../i18n/utils';
import { percorso, traduzioni } from '../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);

const impostazioni = await getEntry('impostazioni', 'generale');
const dati = impostazioni?.data;
const anno = new Date().getFullYear();
---

<footer class="bg-sand">
	<div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:px-10 md:grid-cols-4">
		<div>
			<p class="font-heading text-xl text-ink">{dati?.nomeAttivita}</p>
			<p class="mt-3.5 text-[15px] leading-relaxed text-muted">{dati?.indirizzo}</p>
		</div>
		<div>
			<p class="text-xs font-semibold tracking-[0.16em] text-clay-dark uppercase">{t.contatti.titolo}</p>
			<p class="mt-3.5 text-[15px] leading-loose text-muted">Tel. {dati?.telefono}<br />{dati?.email}</p>
		</div>
		<div>
			<p class="text-xs font-semibold tracking-[0.16em] text-clay-dark uppercase">{t.footer.orari}</p>
			<p class="mt-3.5 text-[15px] leading-loose text-muted">{dati?.orari}</p>
		</div>
		<div>
			<p class="text-xs font-semibold tracking-[0.16em] text-clay-dark uppercase">{t.footer.linkUtili}</p>
			<ul class="mt-3.5 flex flex-col gap-2 text-[15px] text-muted">
				<li><a href={percorso(lang, '/prodotti')} class="text-muted hover:text-ink">{t.nav.prodotti}</a></li>
				<li><a href={percorso(lang, '/servizi')} class="text-muted hover:text-ink">{t.nav.servizi}</a></li>
				<li><a href={percorso(lang, '/chi-siamo')} class="text-muted hover:text-ink">{t.nav.chiSiamo}</a></li>
				<li><a href={percorso(lang, '/contatti')} class="text-muted hover:text-ink">{t.nav.contatti}</a></li>
			</ul>
		</div>
	</div>
	<div class="border-t border-line px-6 py-5 text-[13px] text-faint sm:px-10">
		&copy; {anno} {dati?.nomeAttivita}. {t.footer.dirittiRiservati}
	</div>
</footer>
