---
import { getEntry } from 'astro:content';
import type { Lingua } from '../i18n/utils';
import { percorso, traduzioni } from '../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);

const impostazioni = await getEntry('impostazioni', 'generale');
const dati = impostazioni?.data;
const anno = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
		<div>
			<p class="text-lg font-semibold text-white">{dati?.nomeAttivita}</p>
			<p class="mt-3 text-sm leading-relaxed">{dati?.indirizzo}</p>
			<p class="mt-1 text-sm">Tel. {dati?.telefono}</p>
			<p class="text-sm">{dati?.email}</p>
			{dati?.piva && <p class="mt-3 text-xs text-stone-500">P.IVA {dati.piva}</p>}
			<div class="mt-4 flex gap-3">
				{dati?.facebook && (
					<a
						href={dati.facebook}
						class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-700 text-stone-300 transition-colors hover:border-amber-700 hover:text-amber-500"
						aria-label="Facebook"
					>
						FB
					</a>
				)}
				{dati?.instagram && (
					<a
						href={dati.instagram}
						class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-700 text-stone-300 transition-colors hover:border-amber-700 hover:text-amber-500"
						aria-label="Instagram"
					>
						IG
					</a>
				)}
			</div>
		</div>

		<div>
			<p class="text-sm font-semibold uppercase tracking-wide text-white">{t.footer.orari}</p>
			<p class="mt-3 text-sm leading-relaxed">{dati?.orari}</p>
		</div>

		<div>
			<p class="text-sm font-semibold uppercase tracking-wide text-white">{t.footer.linkUtili}</p>
			<ul class="mt-3 space-y-2 text-sm">
				<li><a href={percorso(lang, '/prodotti')} class="hover:text-amber-500">{t.nav.prodotti}</a></li>
				<li><a href={percorso(lang, '/chi-siamo')} class="hover:text-amber-500">{t.nav.chiSiamo}</a></li>
				<li><a href={percorso(lang, '/contatti')} class="hover:text-amber-500">{t.nav.contatti}</a></li>
			</ul>
		</div>
	</div>
	<div class="border-t border-stone-800 px-4 py-4 text-center text-xs text-stone-500 sm:px-6">
		&copy; {anno} {dati?.nomeAttivita}. {t.footer.dirittiRiservati}
	</div>
</footer>
