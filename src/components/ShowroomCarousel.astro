---
interface Props {
	immagini: { src: string; alt: string }[];
	class?: string;
	indicatori?: boolean;
	intervallo?: number;
}

const { immagini, class: className = '', indicatori = false, intervallo = 3500 } = Astro.props;
const id = `showroom-${Math.random().toString(36).slice(2, 8)}`;
const mostraIndicatori = indicatori && immagini.length > 1;
---

<div id={id} class:list={['overflow-hidden', className]}>
	{immagini.map((img, i) => (
		<img
			src={img.src}
			alt={img.alt}
			data-slide
			class:list={[
				'absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ease-in-out',
				i === 0 ? 'opacity-100' : 'opacity-0',
			]}
		/>
	))}
	{mostraIndicatori && (
		<div class="absolute inset-x-0 bottom-3 z-10 flex justify-center gap-1.5">
			{immagini.map((_, i) => (
				<button
					type="button"
					data-punto
					aria-label={`Immagine ${i + 1} di ${immagini.length}`}
					class:list={[
						'h-1.5 rounded-full shadow-sm transition-all duration-300',
						i === 0 ? 'w-5 bg-white' : 'w-1.5 bg-white/60 hover:bg-white/80',
					]}
				>
				</button>
			))}
		</div>
	)}
</div>

<script define:vars={{ id, intervallo }}>
	(function () {
		const contenitore = document.getElementById(id);
		if (!contenitore) return;
		const slide = contenitore.querySelectorAll('[data-slide]');
		const punti = contenitore.querySelectorAll('[data-punto]');
		if (slide.length < 2) return;

		let indice = 0;
		let timer;

		function vai(nuovoIndice) {
			slide[indice].classList.replace('opacity-100', 'opacity-0');
			if (punti[indice]) {
				punti[indice].classList.replace('w-5', 'w-1.5');
				punti[indice].classList.replace('bg-white', 'bg-white/60');
			}
			indice = nuovoIndice;
			slide[indice].classList.replace('opacity-0', 'opacity-100');
			if (punti[indice]) {
				punti[indice].classList.replace('w-1.5', 'w-5');
				punti[indice].classList.replace('bg-white/60', 'bg-white');
			}
		}

		function riavvia() {
			clearInterval(timer);
			timer = setInterval(() => vai((indice + 1) % slide.length), intervallo);
		}

		punti.forEach((punto, i) => {
			punto.addEventListener('click', () => {
				if (i !== indice) vai(i);
				riavvia();
			});
		});

		riavvia();
	})();
</script>
