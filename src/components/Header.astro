---
import LangToggle from './LangToggle.astro';
import type { Lingua } from '../i18n/utils';
import { percorso, traduzioni } from '../i18n/utils';

interface Props {
	lang: Lingua;
	trasparente?: boolean;
}

const { lang, trasparente = false } = Astro.props;
const t = traduzioni(lang);

const voci = [
	{ href: percorso(lang, '/'), label: t.nav.home },
	{ href: percorso(lang, '/prodotti'), label: t.nav.prodotti },
	{ href: percorso(lang, '/servizi'), label: t.nav.servizi },
	{ href: percorso(lang, '/chi-siamo'), label: t.nav.chiSiamo },
	{ href: percorso(lang, '/contatti'), label: t.nav.contatti },
];

const percorsoAttuale = Astro.url.pathname;
const percorsoHome = percorso(lang, '/');
---

<header
	id="header-sito"
	class:list={['sticky top-0 z-50', trasparente ? 'header-flottante' : 'bg-cream/95 backdrop-blur']}
>
	<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5 sm:px-10">
		<a href={percorsoHome} class="flex flex-col leading-tight text-ink">
			<span class="font-heading text-2xl">Arredamenti</span>
			<span class="text-[11px] font-semibold tracking-[0.34em] text-clay-dark uppercase">Due Torri</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex">
			{voci.map((voce) => {
				const attiva = percorsoAttuale === voce.href || (voce.href !== percorsoHome && percorsoAttuale.startsWith(voce.href));
				return (
					<a
						href={voce.href}
						class:list={['rounded-full px-4 py-2.5 text-[15px] transition-colors', attiva ? 'bg-sand text-ink' : 'text-muted hover:bg-sand/60']}
					>
						{voce.label}
					</a>
				);
			})}
			<LangToggle lang={lang} />
			<a href={percorso(lang, '/contatti')} class="ml-2 rounded-full bg-clay px-6 py-3 text-[15px] font-medium text-white transition-colors hover:bg-clay-dark">
				{t.nav.ctaHeader}
			</a>
		</nav>

		<div class="flex items-center gap-2 md:hidden">
			<a href={`tel:${t.telefonoGrezzo}`} class="rounded-full border border-line px-4 py-2.5 text-sm text-ink">{t.nav.chiama}</a>
			<button
				id="menu-toggle"
				type="button"
				aria-label={t.nav.apriMenu}
				aria-expanded="false"
				class="flex h-11 w-11 flex-col items-center justify-center gap-1.5"
			>
				<span class="block h-[1.5px] w-6 rounded bg-ink"></span>
				<span class="block h-[1.5px] w-6 rounded bg-ink"></span>
			</button>
		</div>
	</div>
</header>

<div
	id="menu-mobile"
	class="fixed inset-x-0 bottom-0 z-40 hidden flex-col bg-ink text-cream md:hidden"
	style={`top: var(--altezza-header, 88px)`}
>
	<nav class="flex flex-col px-6 pt-6">
		{voci.map((voce) => (
			<a href={voce.href} class="border-b border-white/10 py-4 font-heading text-3xl">{voce.label}</a>
		))}
	</nav>
	<div class="flex justify-start px-6 pt-4">
		<LangToggle lang={lang} />
	</div>
	<div class="mt-auto flex flex-col gap-3 px-6 pb-10">
		<a href={percorso(lang, '/contatti')} class="rounded-full bg-clay px-6 py-4 text-center text-[15px] font-medium text-white">{t.nav.ctaHeader}</a>
		<a href={`tel:${t.telefonoGrezzo}`} class="rounded-full border border-white/30 px-6 py-4 text-center text-[15px]">{t.telefono}</a>
	</div>
</div>

<script>
	(function () {
		const apri = document.getElementById('menu-toggle');
		const menu = document.getElementById('menu-mobile');
		if (!apri || !menu) return;

		const header = document.getElementById('header-sito');

		function apriMenu() {
			menu!.classList.remove('hidden');
			menu!.classList.add('flex');
			apri!.setAttribute('aria-expanded', 'true');
			header?.classList.add('menu-aperto');
		}
		function chiudiMenu() {
			menu!.classList.add('hidden');
			menu!.classList.remove('flex');
			apri!.setAttribute('aria-expanded', 'false');
			header?.classList.remove('menu-aperto');
		}

		apri.addEventListener('click', () => {
			if (apri.getAttribute('aria-expanded') === 'true') chiudiMenu();
			else apriMenu();
		});
		menu.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', chiudiMenu));
	})();
</script>

<style>
	.header-flottante {
		background-color: transparent;
		background-image: linear-gradient(to bottom, rgb(46 42 38 / 0.32), rgb(46 42 38 / 0));
		transition:
			background-color 0.4s ease,
			backdrop-filter 0.4s ease;
	}
	.header-flottante.is-scrolled {
		background-image: none;
		background-color: rgb(250 247 242 / 0.95);
		backdrop-filter: blur(12px);
	}
	@media (max-width: 767px) {
		.header-flottante {
			background-image: none;
			background-color: rgb(250 247 242 / 0.95);
			backdrop-filter: blur(12px);
		}
	}

	#header-sito.menu-aperto {
		background-color: var(--color-ink) !important;
		background-image: none !important;
		backdrop-filter: none !important;
	}
	#header-sito.menu-aperto .text-ink {
		color: var(--color-cream) !important;
	}
	#header-sito.menu-aperto .text-clay-dark {
		color: var(--color-clay) !important;
	}
	#header-sito.menu-aperto .border-line {
		border-color: rgb(250 247 242 / 0.3) !important;
	}
	#header-sito.menu-aperto .bg-ink {
		background-color: var(--color-cream) !important;
	}
</style>

<script>
	(function () {
		const header = document.getElementById('header-sito');
		if (!header) return;

		function impostaAltezza() {
			document.documentElement.style.setProperty('--altezza-header', `${header!.offsetHeight}px`);
		}
		impostaAltezza();
		window.addEventListener('load', impostaAltezza);
		window.addEventListener('resize', impostaAltezza);

		if (!header.classList.contains('header-flottante')) return;

		function aggiornaScroll() {
			header!.classList.toggle('is-scrolled', window.scrollY > 24);
		}
		aggiornaScroll();
		window.addEventListener('scroll', aggiornaScroll, { passive: true });
	})();
</script>
