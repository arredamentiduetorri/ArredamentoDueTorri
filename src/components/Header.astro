---
import { getEntry } from 'astro:content';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import type { Lingua } from '../i18n/utils';
import { percorso, traduzioni } from '../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);

const impostazioni = await getEntry('impostazioni', 'generale');
const nomeAttivita = impostazioni?.data.nomeAttivita ?? 'Arredamento Due Torri';
const iniziali = nomeAttivita
	.split(' ')
	.map((parola) => parola[0])
	.join('')
	.slice(0, 3)
	.toUpperCase();

const voci = [
	{ href: percorso(lang, '/'), label: t.nav.home },
	{ href: percorso(lang, '/prodotti'), label: t.nav.prodotti },
	{ href: percorso(lang, '/chi-siamo'), label: t.nav.chiSiamo },
	{ href: percorso(lang, '/contatti'), label: t.nav.contatti },
];

const percorsoAttuale = Astro.url.pathname;
const percorsoHome = percorso(lang, '/');
---

<header class="sticky top-0 z-50 border-b border-stone-200 bg-stone-50/95 backdrop-blur dark:border-stone-800 dark:bg-stone-950/95">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
		<a href={percorsoHome} class="flex items-center gap-3">
			<span
				class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-amber-700 text-base font-bold tracking-wide text-amber-800 dark:border-amber-500 dark:text-amber-500"
			>
				{iniziali}
			</span>
			<span class="hidden text-xl font-semibold tracking-tight text-stone-900 sm:inline dark:text-white">
				{nomeAttivita}
			</span>
		</a>
		<div class="flex items-center gap-2 sm:gap-4">
			<nav>
				<ul class="flex items-center gap-1 text-sm font-medium whitespace-nowrap text-stone-600 sm:gap-3 sm:text-base dark:text-stone-300">
					{voci.map((voce) => {
						const attiva =
							percorsoAttuale === voce.href ||
							(voce.href !== percorsoHome && percorsoAttuale.startsWith(voce.href));
						return (
							<li>
								<a
									href={voce.href}
									class:list={[
										'rounded-full px-2 py-2 transition-colors hover:text-amber-800 sm:px-3 dark:hover:text-amber-500',
										attiva && 'font-semibold text-amber-800 dark:text-amber-500',
									]}
								>
									{voce.label}
								</a>
							</li>
						);
					})}
				</ul>
			</nav>
			<div class="h-6 w-px bg-stone-300/70 dark:bg-stone-700/70"></div>
			<LangToggle lang={lang} />
			<ThemeToggle lang={lang} />
		</div>
	</div>
</header>
