---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../ProductCard.astro';
import { getCollection } from 'astro:content';
import type { Lingua } from '../../i18n/utils';
import { traduzioni } from '../../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);

const prodotti = await getCollection('prodotti', ({ id }) => id.startsWith(`${lang}/`));
const categorie = [...new Set(prodotti.map((p) => p.data.categoria))].map((nome) => ({
	nome,
	conteggio: prodotti.filter((p) => p.data.categoria === nome).length,
}));
---

<Layout titolo={t.prodotti.titolo}>
	<section class="mx-auto max-w-6xl px-6 py-16 sm:px-10">
		<p class="text-[13px] font-semibold tracking-[0.16em] text-clay-dark uppercase">{t.prodotti.categorieLabel}</p>
		<h1 class="mt-4.5 text-6xl">{t.prodotti.titolo}</h1>
		<p class="mt-4 max-w-[56ch] text-lg leading-relaxed text-muted">{t.prodotti.sottotitolo}</p>

		<div id="pagina-prodotti" class="mt-10">
			<div class="flex flex-wrap gap-2">
				<button type="button" data-filtro="tutte" aria-current="true" class="filtro-btn rounded-full border px-5 py-2.5 text-[15px] transition-colors border-clay bg-clay text-white">
					{t.prodotti.tutte} <span class="opacity-60">({prodotti.length})</span>
				</button>
				{categorie.map((cat) => (
					<button type="button" data-filtro={cat.nome} class="filtro-btn rounded-full border border-line px-5 py-2.5 text-[15px] text-muted transition-colors">
						{cat.nome} <span class="opacity-60">({cat.conteggio})</span>
					</button>
				))}
			</div>

			<div id="griglia-prodotti" class="mt-9 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
				{prodotti.map((prodotto) => <ProductCard prodotto={prodotto} lang={lang} />)}
			</div>
			<nav id="pager-prodotti" class="mt-12 flex items-center justify-center gap-1" aria-label="Paginazione"></nav>
		</div>
	</section>
</Layout>

<script>
	(function () {
		const DIMENSIONE_PAGINA = 9;
		const contenitore = document.getElementById('pagina-prodotti');
		const griglia = document.getElementById('griglia-prodotti');
		const pager = document.getElementById('pager-prodotti');
		if (!contenitore || !griglia || !pager) return;

		const bottoniFiltro = contenitore.querySelectorAll<HTMLButtonElement>('[data-filtro]');
		const schede = Array.from(griglia.querySelectorAll<HTMLElement>('[data-categoria]'));

		let filtroAttivo = 'tutte';
		let paginaAttiva = 1;

		function schedeFiltrate(): HTMLElement[] {
			return schede.filter((scheda) => filtroAttivo === 'tutte' || scheda.dataset.categoria === filtroAttivo);
		}

		function bottonePager(contenuto: string, { attivo = false, disabilitato = false } = {}, onClick?: () => void) {
			const b = document.createElement('button');
			b.type = 'button';
			b.textContent = contenuto;
			b.disabled = disabilitato;
			b.className = attivo
				? 'flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-clay text-sm text-white'
				: 'flex h-10 min-w-10 shrink-0 items-center justify-center rounded-full px-2 text-sm text-muted transition-colors hover:bg-sand disabled:opacity-30 disabled:hover:bg-transparent';
			if (onClick && !disabilitato) b.addEventListener('click', onClick);
			return b;
		}

		function vaiAllaPagina(pagina: number) {
			paginaAttiva = pagina;
			aggiorna();
			griglia?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}

		function renderPager(totalePagine: number) {
			if (!pager) return;
			pager.innerHTML = '';
			if (totalePagine <= 1) return;
			pager.appendChild(bottonePager('‹', { disabilitato: paginaAttiva === 1 }, () => vaiAllaPagina(paginaAttiva - 1)));
			for (let i = 1; i <= totalePagine; i++) {
				pager.appendChild(bottonePager(String(i), { attivo: i === paginaAttiva }, () => vaiAllaPagina(i)));
			}
			pager.appendChild(bottonePager('›', { disabilitato: paginaAttiva === totalePagine }, () => vaiAllaPagina(paginaAttiva + 1)));
		}

		function aggiorna() {
			const filtrate = schedeFiltrate();
			const totalePagine = Math.max(1, Math.ceil(filtrate.length / DIMENSIONE_PAGINA));
			if (paginaAttiva > totalePagine) paginaAttiva = totalePagine;
			const inizio = (paginaAttiva - 1) * DIMENSIONE_PAGINA;
			const fine = inizio + DIMENSIONE_PAGINA;

			schede.forEach((scheda) => scheda.classList.add('hidden'));
			filtrate.forEach((scheda, i) => scheda.classList.toggle('hidden', i < inizio || i >= fine));

			renderPager(totalePagine);
		}

		function applicaFiltro(filtro: string) {
			filtroAttivo = filtro;
			paginaAttiva = 1;
			bottoniFiltro.forEach((bottone) => {
				const attivo = bottone.dataset.filtro === filtro;
				bottone.setAttribute('aria-current', String(attivo));
				bottone.classList.toggle('bg-clay', attivo);
				bottone.classList.toggle('border-clay', attivo);
				bottone.classList.toggle('text-white', attivo);
				bottone.classList.toggle('border-line', !attivo);
				bottone.classList.toggle('text-muted', !attivo);
			});
			aggiorna();
		}

		bottoniFiltro.forEach((bottone) => bottone.addEventListener('click', () => applicaFiltro(bottone.dataset.filtro ?? 'tutte')));

		aggiorna();
	})();
</script>
