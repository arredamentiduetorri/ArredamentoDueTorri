---
import Layout from '../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import type { Lingua } from '../../i18n/utils';
import { traduzioni } from '../../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);
const pagina = await getEntry('pagine', `${lang}/contatti`);
const { Content } = await render(pagina!);
const impostazioni = await getEntry('impostazioni', 'generale');
const dati = impostazioni?.data;
const formName = `contatti-${lang}`;
---

<Layout titolo={pagina!.data.titolo}>
	<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold text-stone-900 dark:text-white">{pagina!.data.titolo}</h1>
		<div class="prose prose-stone dark:prose-invert mt-4 max-w-none text-stone-700">
			<Content />
		</div>

		<div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-2">
			<div class="space-y-4 rounded-lg border border-stone-200 p-6 dark:border-stone-800">
				<div>
					<p class="text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">{t.contatti.indirizzo}</p>
					<p class="text-stone-800 dark:text-stone-200">{dati?.indirizzo}</p>
				</div>
				<div>
					<p class="text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">{t.contatti.telefono}</p>
					<p class="text-stone-800 dark:text-stone-200">{dati?.telefono}</p>
				</div>
				<div>
					<p class="text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">{t.contatti.email}</p>
					<p class="text-stone-800 dark:text-stone-200">{dati?.email}</p>
				</div>
				<div>
					<p class="text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">{t.contatti.orari}</p>
					<p class="text-stone-800 dark:text-stone-200">{dati?.orari}</p>
				</div>
			</div>

			<form name={formName} method="POST" data-netlify="true" class="space-y-4">
				<input type="hidden" name="form-name" value={formName} />
				<div>
					<label for="nome" class="block text-sm font-medium text-stone-700 dark:text-stone-300">{t.contatti.formNome}</label>
					<input
						id="nome"
						name="nome"
						type="text"
						required
						class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none dark:border-stone-700 dark:bg-stone-900 dark:text-white dark:focus:border-amber-500"
					/>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-stone-700 dark:text-stone-300">{t.contatti.formEmail}</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none dark:border-stone-700 dark:bg-stone-900 dark:text-white dark:focus:border-amber-500"
					/>
				</div>
				<div>
					<label for="messaggio" class="block text-sm font-medium text-stone-700 dark:text-stone-300">{t.contatti.formMessaggio}</label>
					<textarea
						id="messaggio"
						name="messaggio"
						rows="4"
						required
						class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none dark:border-stone-700 dark:bg-stone-900 dark:text-white dark:focus:border-amber-500"
					></textarea>
				</div>
				<button
					type="submit"
					class="rounded-md bg-stone-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-stone-700 dark:bg-amber-600 dark:hover:bg-amber-500"
				>
					{t.contatti.formInvia}
				</button>
			</form>
		</div>
	</section>
</Layout>
