---
import Layout from '../../layouts/Layout.astro';
import MappaContatti from '../MappaContatti.astro';
import { getEntry, render } from 'astro:content';
import type { Lingua } from '../../i18n/utils';
import { traduzioni } from '../../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);
const pagina = await getEntry('pagine', `${lang}/contatti`);
const { Content } = await render(pagina!);
const impostazioni = await getEntry('impostazioni', 'generale');
const dati = impostazioni?.data;
const formName = `contatti-${lang}`;
---

<Layout titolo={pagina!.data.titolo}>
	<section class="mx-auto max-w-6xl px-6 py-16 sm:px-10">
		<div class="grid grid-cols-1 gap-16 lg:grid-cols-[5fr_7fr]">
			<div>
				<h1 class="text-5xl leading-[1.06]">{t.contatti.titolo}</h1>
				<div class="prose prose-neutral mt-4.5 max-w-none text-[17px] leading-relaxed text-muted">
					<Content />
				</div>
				<div class="mt-8 aspect-[4/3] overflow-hidden rounded-[1.75rem]">
					<img src="/images/shop.jpeg" alt={dati?.nomeAttivita} class="h-full w-full object-cover" />
				</div>
				<div class="mt-5 rounded-3xl bg-sand px-6">
					<table class="w-full border-collapse text-[15px]">
						<tbody>
							<tr>
								<td class="w-1/3 py-3.5 text-faint">{t.contatti.indirizzo}</td>
								<td class="py-3.5">{dati?.indirizzo}</td>
							</tr>
							<tr>
								<td class="py-3.5 text-faint">{t.contatti.telefono}</td>
								<td class="py-3.5"><a href={`tel:${dati?.telefono?.replace(/\s+/g, '')}`}>{dati?.telefono}</a></td>
							</tr>
							<tr>
								<td class="py-3.5 text-faint">{t.contatti.email}</td>
								<td class="py-3.5 break-all"><a href={`mailto:${dati?.email}`}>{dati?.email}</a></td>
							</tr>
							<tr>
								<td class="py-3.5 text-faint">{t.contatti.orari}</td>
								<td class="py-3.5 whitespace-pre-line">{dati?.orari}</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<form name={formName} method="POST" data-netlify="true" class="flex flex-col gap-6">
				<input type="hidden" name="form-name" value={formName} />
				<div class="grid grid-cols-1 gap-4.5 sm:grid-cols-2">
					<div class="flex flex-col gap-2">
						<label for="nome" class="text-sm text-faint">{t.contatti.formNome}</label>
						<input id="nome" name="nome" type="text" required class="rounded-2xl border border-line bg-white px-4.5 py-3.5 text-base focus:outline-none" />
					</div>
					<div class="flex flex-col gap-2">
						<label for="email" class="text-sm text-faint">{t.contatti.formEmail}</label>
						<input id="email" name="email" type="email" required class="rounded-2xl border border-line bg-white px-4.5 py-3.5 text-base focus:outline-none" />
					</div>
				</div>
				<div class="flex flex-col gap-2">
					<label for="messaggio" class="text-sm text-faint">{t.contatti.formMessaggio}</label>
					<textarea id="messaggio" name="messaggio" rows={5} required class="resize-y rounded-2xl border border-line bg-white px-4.5 py-3.5 text-base focus:outline-none"></textarea>
				</div>
				<button type="submit" class="self-start rounded-full bg-clay px-9 py-4 text-base font-medium text-white transition-colors hover:bg-clay-dark">
					{t.contatti.formInvia}
				</button>
			</form>
		</div>
	</section>

	<section class="mt-8 sm:mt-16">
		<MappaContatti
			lat={44.6289044}
			lon={11.1968628}
			nomeAttivita={dati?.nomeAttivita ?? ''}
			indirizzo={dati?.indirizzo}
			telefono={dati?.telefono}
			email={dati?.email}
			etichettaTelefono={t.contatti.telefono}
			etichettaEmail={t.contatti.email}
			etichettaSito={t.home.mappaSito}
		/>
	</section>
</Layout>
