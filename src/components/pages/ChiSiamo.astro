---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import type { Lingua } from '../../i18n/utils';
import { traduzioni } from '../../i18n/utils';
import { risolviImmagine } from '../../lib/immagini';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);
const pagina = await getEntry('pagine', `${lang}/chi-siamo`);
const { Content } = await render(pagina!);
const tappe = (pagina!.data.tappe ?? []).map((tappa) => ({ ...tappa, immagineRisolta: risolviImmagine(tappa.immagine) }));
const immagineHero = risolviImmagine('/images/storia/08-oggi.jpg');
---

<Layout titolo={pagina!.data.titolo}>
	<section class="mx-auto max-w-6xl px-6 py-16 sm:px-10">
		<div class="grid grid-cols-1 items-center gap-14 md:grid-cols-2">
			<div>
				<h1 class="text-6xl">{pagina!.data.titolo}</h1>
				<div class="prose prose-neutral mt-6 max-w-none text-[17px] leading-relaxed text-muted">
					<Content />
				</div>
			</div>
			<div class="aspect-[4/5] overflow-hidden rounded-t-[200px] rounded-b-3xl">
				{typeof immagineHero === 'string' ? (
					<img src={immagineHero} alt={pagina!.data.titolo} class="h-full w-full object-cover" />
				) : (
					<Image src={immagineHero} alt={pagina!.data.titolo} format="webp" class="h-full w-full object-cover" />
				)}
			</div>
		</div>
	</section>

	{tappe.length > 0 && (
		<section class="mx-auto max-w-6xl px-6 py-20 sm:px-10">
			<div class="text-center">
				<h2 class="text-4xl">{t.chiSiamo.storiaHeading}</h2>
				<p class="mx-auto mt-3.5 max-w-[52ch] text-[17px] leading-relaxed text-muted">{t.chiSiamo.storiaTesto}</p>
			</div>

			<div id="cronologia" class="relative mt-16">
				<div class="pointer-events-none absolute inset-y-1 left-1/2 hidden w-px -translate-x-1/2 bg-line md:block" aria-hidden="true"></div>
				<div
					id="cronologia-progresso"
					class="pointer-events-none absolute top-1 left-1/2 hidden w-px -translate-x-1/2 bg-clay md:block"
					style="height: 0px"
					aria-hidden="true"
				>
				</div>

				<div class="flex flex-col gap-14">
					{tappe.map((tappa, i) => (
						<div class="tappa grid grid-cols-1 items-center gap-14 md:grid-cols-2">
							<div class:list={[i % 2 === 0 ? 'md:order-1' : 'md:order-2', 'tappa-immagine relative aspect-[5/4] overflow-hidden rounded-[2rem]']}>
								{typeof tappa.immagineRisolta === 'string' ? (
									<img src={tappa.immagineRisolta} alt={tappa.titolo} loading="lazy" class="h-full w-full object-cover" />
								) : (
									<Image src={tappa.immagineRisolta} alt={tappa.titolo} loading="lazy" format="webp" class="h-full w-full object-cover" />
								)}
								<div class="tappa-velo pointer-events-none absolute inset-0 bg-ink" aria-hidden="true"></div>
							</div>
							<div class:list={[i % 2 === 0 ? 'md:order-2' : 'md:order-1']}>
								<span class="tappa-numero flex h-9.5 w-9.5 items-center justify-center rounded-full bg-[#efe1d6] font-heading text-[16px] text-clay-dark">{i + 1}</span>
								<h3 class="tappa-titolo mt-4.5 text-[28px]">{tappa.titolo}</h3>
								<p class="tappa-testo mt-3 text-base leading-relaxed">{tappa.testo}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>
	)}
</Layout>

<style>
	.tappa-immagine {
		transform: scale(1);
		transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.tappa-velo {
		opacity: 0.55;
		transition: opacity 0.8s ease;
	}
	.tappa-numero,
	.tappa-titolo,
	.tappa-testo {
		transition:
			color 0.5s ease,
			background-color 0.5s ease;
	}
	.tappa:not(.is-active) .tappa-titolo,
	.tappa:not(.is-active) .tappa-testo {
		color: var(--color-faint);
	}
	.tappa.is-active .tappa-immagine {
		transform: scale(1.045);
	}
	.tappa.is-active .tappa-velo {
		opacity: 0;
	}
	.tappa.is-active .tappa-numero {
		background-color: var(--color-clay);
		color: white;
	}
	.tappa.is-active .tappa-titolo {
		color: var(--color-ink);
	}
	.tappa.is-active .tappa-testo {
		color: var(--color-muted);
	}
	@media (prefers-reduced-motion: reduce) {
		.tappa-immagine,
		.tappa-velo,
		.tappa-numero,
		.tappa-titolo,
		.tappa-testo {
			transition: none;
		}
	}
</style>

<script>
	(function () {
		const cronologia = document.getElementById('cronologia');
		const progresso = document.getElementById('cronologia-progresso');
		const tappe = Array.from(document.querySelectorAll('.tappa'));
		if (!cronologia || !progresso || tappe.length === 0) return;

		function aggiornaProgresso() {
			const rect = cronologia!.getBoundingClientRect();
			const centro = window.innerHeight / 2;
			const percorsi = Math.min(Math.max(centro - rect.top, 0), rect.height);
			progresso!.style.height = `${percorsi}px`;
		}

		let richiesto = false;
		function onScroll() {
			if (richiesto) return;
			richiesto = true;
			requestAnimationFrame(() => {
				aggiornaProgresso();
				richiesto = false;
			});
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll);
		aggiornaProgresso();

		if ('IntersectionObserver' in window) {
			const osservatore = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						entry.target.classList.toggle('is-active', entry.isIntersecting);
					});
				},
				{ rootMargin: '-45% 0px -45% 0px', threshold: 0 },
			);
			tappe.forEach((tappa) => osservatore.observe(tappa));
		} else {
			tappe.forEach((tappa) => tappa.classList.add('is-active'));
		}
	})();
</script>
