---
import Layout from '../../layouts/Layout.astro';
import type { Lingua } from '../../i18n/utils';
import { percorso, traduzioni } from '../../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);
---

<Layout titolo={t.contatti.grazieTitolo}>
	<section class="mx-auto flex max-w-2xl flex-col items-center px-6 py-24 text-center sm:px-10 sm:py-32">
		<span class="flex h-14 w-14 items-center justify-center rounded-full bg-[#efe1d6] text-clay-dark">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="h-7 w-7" fill="currentColor">
				<path
					fill-rule="evenodd"
					d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
					clip-rule="evenodd"
				></path>
			</svg>
		</span>
		<h1 class="mt-6 text-5xl leading-[1.06]">{t.contatti.grazieTitolo}</h1>
		<p class="mt-4.5 max-w-[46ch] text-lg leading-relaxed text-muted">{t.contatti.grazieTesto}</p>
		<a href={percorso(lang, '/')} class="mt-9 rounded-full bg-clay px-7 py-4 text-[15px] font-medium text-white transition-colors hover:bg-clay-dark">
			{t.contatti.grazieBottone}
		</a>
	</section>
</Layout>
