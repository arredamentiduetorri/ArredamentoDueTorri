---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../ProductCard.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Lingua } from '../../i18n/utils';
import { percorso, traduzioni } from '../../i18n/utils';
import { iconePerSlug, slugProdotto, immagineSegnaposto } from '../../lib/iconeProdotti';

interface Props {
	lang: Lingua;
	prodotto: CollectionEntry<'prodotti'>;
}

const { lang, prodotto } = Astro.props;
const t = traduzioni(lang);
const { nome, categoria, immagine } = prodotto.data;
const { Content } = await render(prodotto);
const icona = immagineSegnaposto(immagine) ? iconePerSlug[slugProdotto(prodotto.id)] : undefined;

const altriProdotti = await getCollection(
	'prodotti',
	(p) => p.id.startsWith(`${lang}/`) && p.data.categoria === categoria && p.id !== prodotto.id,
);
---

<Layout titolo={nome}>
	<section class="mx-auto max-w-6xl px-6 py-16 sm:px-10">
		<a href={percorso(lang, '/prodotti')} class="text-[15px] text-muted hover:text-ink">&larr; {t.prodotti.tornaAiProdotti}</a>
		<div class="mt-7 grid grid-cols-1 gap-14 lg:grid-cols-[3fr_2fr] lg:items-start">
			<div class="aspect-[4/3] overflow-hidden rounded-[1.75rem] bg-sand">
				{icona ? (
					<div class="flex h-full w-full items-center justify-center bg-[#efe1d6]">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-24 w-24 text-clay-dark/50" fill="currentColor" set:html={icona} />
					</div>
				) : (
					<img src={immagine} alt={nome} class="h-full w-full object-cover" />
				)}
			</div>
			<div>
				<p class="text-xs font-semibold tracking-[0.16em] text-clay-dark uppercase">{categoria} · su misura</p>
				<h1 class="mt-3.5 text-[42px] leading-[1.1]">{nome}</h1>
				<div class="prose prose-neutral mt-5 max-w-none text-[17px] leading-relaxed text-muted">
					<Content />
				</div>
				<a href={percorso(lang, '/contatti')} class="mt-8 inline-block rounded-full bg-clay px-7 py-4 text-[15px] font-medium text-white hover:bg-clay-dark">
					{t.prodotti.richiediInfo}
				</a>
			</div>
		</div>

		{altriProdotti.length > 0 && (
			<div class="mt-20">
				<h2 class="text-2xl">{t.prodotti.altriProdotti}</h2>
				<div class="mt-9 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
					{altriProdotti.slice(0, 3).map((correlato) => <ProductCard prodotto={correlato} lang={lang} />)}
				</div>
			</div>
		)}
	</section>
</Layout>
