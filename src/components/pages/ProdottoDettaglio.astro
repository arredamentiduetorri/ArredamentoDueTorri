---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../ProductCard.astro';
import HeroCarousel from '../HeroCarousel.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Lingua } from '../../i18n/utils';
import { percorso, traduzioni } from '../../i18n/utils';
import { iconePerSlug, slugProdotto, immagineSegnaposto } from '../../lib/iconeProdotti';
import { percentualeSconto } from '../../lib/prezzo';
import { risolviImmagine, fotoCartellaProdotto } from '../../lib/immagini';

interface Props {
	lang: Lingua;
	prodotto: CollectionEntry<'prodotti'>;
}

const { lang, prodotto } = Astro.props;
const t = traduzioni(lang);
const { nome, categoria, immagine, caratteristiche, prezzo, prezzoScontato } = prodotto.data;
const { Content } = await render(prodotto);
const specifiche = (caratteristiche ?? []).filter((c) => c.etichetta.trim() && c.valore.trim());
const slug = slugProdotto(prodotto.id);
const icona = immagineSegnaposto(immagine) ? iconePerSlug[slug] : undefined;
const inSconto = Boolean(prezzo && prezzoScontato);
const percentuale = inSconto ? percentualeSconto(prezzo!, prezzoScontato!) : null;

const fotoProdotto = fotoCartellaProdotto(slug).map((src) => ({ src, alt: nome }));
const immagineRisolta = risolviImmagine(immagine);

const altriProdotti = await getCollection(
	'prodotti',
	(p) => p.id.startsWith(`${lang}/`) && p.data.categoria === categoria && p.id !== prodotto.id,
);
---

<Layout titolo={nome} immagine={typeof immagineRisolta === 'string' ? immagineRisolta : immagineRisolta.src}>
	<section class="mx-auto max-w-7xl px-6 py-16 sm:px-10">
		<a href={percorso(lang, '/prodotti')} class="text-[15px] text-muted hover:text-ink">&larr; {t.prodotti.tornaAiProdotti}</a>
		<div class="mt-7 grid grid-cols-1 gap-14 lg:grid-cols-[3fr_2fr] lg:items-start">
			<div class="relative aspect-[4/3] overflow-hidden rounded-[1.75rem] bg-sand lg:aspect-[5/4]">
				{inSconto && (
					<span class="absolute top-4 left-4 z-10 rounded-full bg-clay px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm">
						{percentuale !== null ? `-${percentuale}%` : t.prodotti.offertaBadge}
					</span>
				)}
				{icona ? (
					<div class="flex h-full w-full items-center justify-center bg-[#efe1d6]">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-24 w-24 text-clay-dark/50" fill="currentColor" set:html={icona} />
					</div>
				) : fotoProdotto.length > 0 ? (
					<HeroCarousel immagini={fotoProdotto} class="absolute inset-0 h-full w-full" />
				) : typeof immagineRisolta === 'string' ? (
					<img src={immagineRisolta} alt={nome} class="h-full w-full object-cover" />
				) : (
					<Image src={immagineRisolta} alt={nome} format="webp" class="h-full w-full object-cover" />
				)}
			</div>
			<div>
				<p class="text-xs font-semibold tracking-[0.16em] text-clay-dark uppercase">{categoria} · su misura</p>
				<h1 class="mt-3.5 text-[42px] leading-[1.1]">{nome}</h1>
				{prezzo && (
					<p class="mt-3 flex flex-wrap items-baseline gap-3">
						{inSconto ? (
							<>
								<span class="text-lg text-faint line-through">{prezzo}</span>
								<span class="text-2xl font-semibold text-clay-dark">{prezzoScontato}</span>
							</>
						) : (
							<span class="text-2xl font-semibold text-clay-dark">{prezzo}</span>
						)}
					</p>
				)}
				<div class="prose prose-neutral mt-5 max-w-none text-[17px] leading-relaxed text-muted">
					<Content />
				</div>

				{specifiche.length > 0 && (
					<div class="mt-8 rounded-[1.5rem] border border-line bg-sand/60 p-6">
						<h2 class="text-xs font-semibold tracking-[0.16em] text-clay-dark uppercase">{t.prodotti.caratteristicheTecniche}</h2>
						<dl class="mt-4 divide-y divide-line/70">
							{specifiche.map((c) => (
								<div class="flex items-baseline justify-between gap-4 py-2.5 text-[15px]">
									<dt class="text-muted">{c.etichetta}</dt>
									<dd class="text-right font-medium text-ink">{c.valore}</dd>
								</div>
							))}
						</dl>
					</div>
				)}

				<a href={percorso(lang, '/contatti')} class="mt-8 inline-block rounded-full bg-clay px-7 py-4 text-[15px] font-medium text-white hover:bg-clay-dark">
					{t.prodotti.richiediInfo}
				</a>
			</div>
		</div>

		{altriProdotti.length > 0 && (
			<div class="mt-20">
				<h2 class="text-2xl">{t.prodotti.altriProdotti}</h2>
				<div class="mt-9 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
					{altriProdotti.slice(0, 3).map((correlato) => <ProductCard prodotto={correlato} lang={lang} />)}
				</div>
			</div>
		)}
	</section>
</Layout>
