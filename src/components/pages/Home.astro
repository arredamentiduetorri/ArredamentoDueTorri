---
import Layout from '../../layouts/Layout.astro';
import HeroCarousel from '../HeroCarousel.astro';
import RecensioneCard from '../RecensioneCard.astro';
import { getEntry, getCollection } from 'astro:content';
import type { Lingua } from '../../i18n/utils';
import { percorso, traduzioni } from '../../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);

const impostazioni = await getEntry('impostazioni', 'generale');
const dati = impostazioni?.data;
const nomeAttivita = dati?.nomeAttivita ?? 'Arredamento Due Torri';

const recensioni = await getCollection('recensioni');
const linkRecensioniGoogle = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${nomeAttivita} ${dati?.indirizzo ?? ''}`)}`;

const fasi = [
	{ numero: '1', titolo: t.home.collezioniHeading.includes('lavoriamo') ? 'Sopralluogo' : 'Sopralluogo', testo: 'Veniamo a misurare, guardiamo luce, prese e passaggi. Gratuito su Persiceto e dintorni.' },
	{ numero: '2', titolo: 'Progetto', testo: 'Ti mostriamo il disegno in pianta e un render, con finiture e prezzo chiaro prima di ordinare.' },
	{ numero: '3', titolo: 'Produzione', testo: 'Lavoriamo con produttori italiani selezionati, per portarti in casa soluzioni di qualità su misura.' },
	{ numero: '4', titolo: 'Montaggio', testo: 'Consegniamo e montiamo noi, e smaltiamo il vecchio arredo se serve.' },
];

const prodotti = await getCollection('prodotti', ({ id }) => id.startsWith(`${lang}/`));
const lavori = prodotti.slice(0, 6);

const foto = [
	{ src: '/images/homeCarouselImages/cucina1.jpg', alt: t.home.showroomAlt },
	{ src: '/images/homeCarouselImages/cucina2.jpg', alt: t.home.showroomAlt },
	{ src: '/images/homeCarouselImages/cucina3.jpg', alt: t.home.showroomAlt },
	{ src: '/images/homeCarouselImages/cucina4.jpg', alt: t.home.showroomAlt },
	{ src: '/images/homeCarouselImages/cucina5.jpg', alt: t.home.showroomAlt },
];
---

<Layout titolo={t.nav.home} headerTrasparente>
	<section class="mx-auto max-w-6xl px-6 py-10 sm:px-10 sm:py-16 md:hidden">
		<div class="grid grid-cols-1 items-center gap-14">
			<div>
				<p class="text-[13px] font-semibold tracking-[0.16em] text-clay-dark uppercase">{t.home.heroEyebrow}</p>
				<h1 class="mt-5 text-5xl leading-[1.06] sm:text-6xl">{t.home.heroTitle}</h1>
				<p class="mt-6 max-w-[40ch] text-lg leading-relaxed text-muted">{t.home.introTesto}</p>
				<div class="mt-9 flex flex-wrap gap-3">
					<a href={percorso(lang, '/contatti')} class="rounded-full bg-clay px-7 py-4 text-[15px] font-medium text-white transition-colors hover:bg-clay-dark">
						{t.home.ctaPreventivo}
					</a>
					<a href={percorso(lang, '/prodotti')} class="rounded-full border border-line px-7 py-[15px] text-[15px] text-ink transition-colors hover:bg-sand">
						{t.home.ctaProdotti}
					</a>
				</div>
			</div>
			<div class="relative">
				<div class="aspect-[4/5] overflow-hidden rounded-t-[200px] rounded-b-3xl">
					<img src={foto[0].src} alt={t.home.showroomAlt} class="h-full w-full object-cover" />
				</div>
				<div class="absolute -left-6 bottom-9 rounded-2xl bg-cream px-6 py-5 shadow-xl">
					<p class="font-heading text-3xl text-clay-dark">5,0</p>
					<p class="mt-0.5 text-[13px] text-faint">su Google, {recensioni.length} recensioni</p>
				</div>
			</div>
		</div>
	</section>

	<section
		class="relative hidden h-[82vh] max-h-[820px] min-h-[560px] items-center md:flex"
		style="margin-top: calc(-1 * var(--altezza-header, 88px)); padding-top: var(--altezza-header, 88px);"
	>
		<HeroCarousel immagini={foto} class="absolute inset-0 h-full w-full" />
		<div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-ink/10"></div>

		<div class="relative mx-auto w-full max-w-6xl px-6 sm:px-10">
			<div class="max-w-xl">
				<p class="text-[13px] font-semibold tracking-[0.16em] text-clay uppercase">{t.home.heroEyebrow}</p>
				<h1 class="mt-5 text-5xl leading-[1.06] text-cream sm:text-6xl">{t.home.heroTitle}</h1>
				<p class="mt-6 max-w-[40ch] text-lg leading-relaxed text-cream/80">{t.home.introTesto}</p>
				<div class="mt-9 flex flex-wrap gap-3">
					<a href={percorso(lang, '/contatti')} class="rounded-full bg-clay px-7 py-4 text-[15px] font-medium text-white transition-colors hover:bg-clay-dark">
						{t.home.ctaPreventivo}
					</a>
					<a href={percorso(lang, '/prodotti')} class="rounded-full border border-cream/40 px-7 py-[15px] text-[15px] text-cream transition-colors hover:bg-cream/10">
						{t.home.ctaProdotti}
					</a>
				</div>
			</div>
		</div>

		<div class="absolute right-6 bottom-6 z-10 rounded-2xl bg-cream/95 px-6 py-5 shadow-xl backdrop-blur sm:right-10 sm:bottom-10">
			<p class="font-heading text-3xl text-clay-dark">5,0</p>
			<p class="mt-0.5 text-[13px] text-faint">su Google, {recensioni.length} recensioni</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16 sm:px-10">
		<div class="rounded-[2.5rem] bg-sand p-10 sm:p-14">
			<h2 class="text-4xl">{t.home.collezioniHeading}</h2>
			<p class="mt-3.5 max-w-[52ch] text-[17px] leading-relaxed text-muted">{t.home.collezioniTesto}</p>
			<div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{fasi.map((f) => (
					<div class="rounded-3xl bg-cream p-7">
						<span class="flex h-9.5 w-9.5 items-center justify-center rounded-full bg-[#efe1d6] font-heading text-[17px] text-clay-dark">{f.numero}</span>
						<h3 class="mt-5 text-[23px]">{f.titolo}</h3>
						<p class="mt-2.5 text-[15px] leading-relaxed text-muted">{f.testo}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16 sm:px-10">
		<div class="flex flex-wrap items-baseline justify-between gap-4">
			<h2 class="text-4xl">{t.prodotti.titolo}</h2>
			<a href={percorso(lang, '/prodotti')} class="text-base">{t.home.ctaProdotti} &rarr;</a>
		</div>
		<div class="mt-9 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
			{lavori.map((prodotto) => (
				<a href={percorso(lang, `/prodotti/${prodotto.id.replace(/^(it|en)\//, '')}`)} class="block text-ink">
					<div class="aspect-[4/3] overflow-hidden rounded-3xl bg-sand">
						<img src={prodotto.data.immagine} alt={prodotto.data.nome} class="h-full w-full object-cover" />
					</div>
					<p class="mt-4.5 text-xs font-semibold tracking-[0.14em] text-clay-dark uppercase">{prodotto.data.categoria}</p>
					<h3 class="mt-2 text-[22px]">{prodotto.data.nome}</h3>
				</a>
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16 sm:px-10">
		<div class="grid grid-cols-1 gap-10 md:grid-cols-2">
			{recensioni.map((r) => <RecensioneCard recensione={r} />)}
		</div>
		<div class="mt-8 flex justify-center">
			<a href={linkRecensioniGoogle} target="_blank" rel="noopener noreferrer" class="rounded-full border border-line px-7 py-4 text-[15px] text-ink hover:bg-sand">
				{t.home.recensioniBottone}
			</a>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-20 sm:px-10">
		<div class="grid grid-cols-1 items-center gap-10 rounded-[2.5rem] bg-ink p-10 text-cream sm:p-16 md:grid-cols-[1fr_auto]">
			<div>
				<h2 class="text-[46px] leading-[1.1] text-cream">Porta le misure.<br />Al resto pensiamo noi.</h2>
				<p class="mt-4.5 max-w-[46ch] text-[17px] leading-relaxed text-[#c9bfb3]">Preventivo gratuito e senza impegno, con il disegno del progetto prima di ordinare.</p>
			</div>
			<div class="flex flex-col gap-3">
				<a href={percorso(lang, '/contatti')} class="rounded-full bg-clay px-7 py-4 text-center text-[15px] font-medium text-white">{t.home.ctaPreventivo}</a>
				<a href={`tel:${t.telefonoGrezzo}`} class="rounded-full border border-white/35 px-7 py-[15px] text-center text-[15px] text-cream">{t.telefono}</a>
			</div>
		</div>
	</section>
</Layout>
