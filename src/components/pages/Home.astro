---
import Layout from '../../layouts/Layout.astro';
import ShowroomCarousel from '../ShowroomCarousel.astro';
import RecensioneCard from '../RecensioneCard.astro';
import MappaContatti from '../MappaContatti.astro';
import { getEntry, getCollection } from 'astro:content';
import type { Lingua } from '../../i18n/utils';
import { percorso, traduzioni } from '../../i18n/utils';

interface Props {
	lang: Lingua;
}

const { lang } = Astro.props;
const t = traduzioni(lang);

const impostazioni = await getEntry('impostazioni', 'generale');
const dati = impostazioni?.data;
const nomeAttivita = dati?.nomeAttivita ?? 'Arredamento Due Torri';

const showroomFoto = [
	{ src: '/images/cucina1.jpg', alt: t.home.showroomAlt },
	{ src: '/images/cucina3.jpg', alt: t.home.showroomAlt },
	{ src: '/images/cucina5.jpg', alt: t.home.showroomAlt },
];

const recensioni = await getCollection('recensioni');
const linkRecensioniGoogle = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${nomeAttivita} ${dati?.indirizzo ?? ''}`)}`;

const collezioni = [
	{
		nome: t.home.categorie.soggiorno,
		icona: '<rect x="4" y="9" width="3.5" height="8" rx="1.4" /><rect x="16.5" y="9" width="3.5" height="8" rx="1.4" /><rect x="5.5" y="4" width="13" height="9" rx="2.2" /><rect x="4.5" y="12.5" width="15" height="4.5" rx="1.6" /><rect x="6" y="18.5" width="1.6" height="2.3" rx="0.5" /><rect x="16.4" y="18.5" width="1.6" height="2.3" rx="0.5" />',
	},
	{
		nome: t.home.categorie.cameraDaLetto,
		icona: '<rect x="1" y="3" width="2.2" height="13" rx="1" /><rect x="3.2" y="9" width="19.8" height="7" rx="1.8" /><rect x="4.5" y="5.5" width="5.5" height="4.5" rx="1.3" /><rect x="2.5" y="16.2" width="1.6" height="3" rx="0.5" /><rect x="21.5" y="16.2" width="1.6" height="3" rx="0.5" />',
	},
	{
		nome: t.home.categorie.cucina,
		icona: '<rect x="5" y="10" width="14" height="8" rx="2" /><rect x="2" y="12" width="3" height="2" rx="1" /><rect x="19" y="12" width="3" height="2" rx="1" /><rect x="5" y="8" width="14" height="2.4" rx="1.2" /><circle cx="12" cy="6.5" r="1.3" />',
	},
	{
		nome: t.home.categorie.complementi,
		icona: '<path d="M9 3h6l2 5H7l2-5z" /><rect x="11.3" y="8.2" width="1.4" height="6.8" rx="0.7" /><rect x="6.5" y="16" width="11" height="2.2" rx="1.1" />',
	},
];
---

<Layout titolo={t.nav.home}>
	<section class="relative flex h-[70vh] min-h-[420px] items-center justify-center overflow-hidden">
		<ShowroomCarousel immagini={showroomFoto} class="absolute inset-0 h-full w-full" />
		<div class="absolute inset-0 bg-stone-900/55"></div>
		<div class="relative px-4 text-center text-white">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-amber-400">
				{t.home.heroEyebrow}
			</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-6xl">
				{t.home.heroTitle}
			</h1>
		</div>
	</section>

	<section class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-4 py-20 sm:px-6 md:grid-cols-2">
		<div>
			<h2 class="text-3xl font-bold text-stone-900 dark:text-white">{t.home.introHeading}</h2>
			<div class="mt-4 h-px w-16 bg-amber-700 dark:bg-amber-500"></div>
			<p class="mt-6 leading-relaxed text-stone-600 dark:text-stone-400">
				{t.home.introTesto}
			</p>
			<div class="mt-8 flex flex-wrap gap-4">
				<a
					href={percorso(lang, '/prodotti')}
					class="rounded-full bg-amber-700 px-6 py-3 text-xs font-semibold uppercase tracking-wide text-white transition-colors hover:bg-amber-800 dark:bg-amber-600 dark:hover:bg-amber-500"
				>
					{t.home.ctaProdotti}
				</a>
				<a
					href={percorso(lang, '/contatti')}
					class="rounded-full border border-amber-700 px-6 py-3 text-xs font-semibold uppercase tracking-wide text-amber-800 transition-colors hover:bg-amber-50 dark:border-amber-500 dark:text-amber-500 dark:hover:bg-stone-900"
				>
					{t.home.ctaPreventivo}
				</a>
			</div>
		</div>
		<div class="mx-auto aspect-square w-full max-w-sm overflow-hidden rounded-full">
			<img src="/images/shop.jpeg" alt={t.home.showroomAlt} class="h-full w-full object-cover" />
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
		<div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:divide-x md:divide-stone-200 dark:md:divide-stone-800">
			<h2 class="text-3xl font-bold text-stone-900 dark:text-white">{t.home.collezioniHeading}</h2>
			<p class="leading-relaxed text-stone-600 md:pl-10 dark:text-stone-400">
				{t.home.collezioniTesto}
			</p>
		</div>
		<div class="mt-12 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4">
			{collezioni.map((collezione) => (
				<a
					href={percorso(lang, '/prodotti')}
					class="group relative flex aspect-square flex-col items-center justify-center gap-3 rounded-2xl border border-amber-200/70 bg-gradient-to-br from-amber-50 to-white p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-amber-300 hover:shadow-lg dark:border-amber-900/40 dark:from-stone-900 dark:to-stone-950 dark:hover:border-amber-700/60"
				>
					<span
						class="flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 text-amber-700 transition-colors duration-300 group-hover:bg-amber-700 group-hover:text-white dark:bg-amber-900/40 dark:text-amber-400 dark:group-hover:bg-amber-600 dark:group-hover:text-white"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-8 w-8" fill="currentColor" set:html={collezione.icona} />
					</span>
					<span class="text-sm font-semibold text-stone-900 dark:text-white">{collezione.nome}</span>
					<span
						class="flex items-center gap-1 text-xs font-medium text-amber-700 opacity-0 transition-opacity duration-300 group-hover:opacity-100 dark:text-amber-400"
					>
						{t.home.collezioniScopri}
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="currentColor">
							<path
								fill-rule="evenodd"
								d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
								clip-rule="evenodd"></path>
						</svg>
					</span>
				</a>
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
		<div class="text-center">
			<h2 class="text-3xl font-bold text-stone-900 dark:text-white">{t.home.recensioniHeading}</h2>
			<p class="mx-auto mt-3 max-w-xl text-stone-600 dark:text-stone-400">{t.home.recensioniTesto}</p>
		</div>
		<div class="mx-auto mt-12 grid max-w-3xl grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2">
			{recensioni.map((recensione) => <RecensioneCard recensione={recensione} />)}
		</div>
		<div class="mt-8 flex justify-center">
			<a
				href={linkRecensioniGoogle}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-full bg-amber-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-amber-800 dark:bg-amber-600 dark:hover:bg-amber-500"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
					<path d="M21.35 11.1h-9.17v2.85h5.27c-.23 1.4-1.66 4.1-5.27 4.1-3.17 0-5.76-2.62-5.76-5.85s2.59-5.85 5.76-5.85c1.8 0 3.01.77 3.7 1.43l2.52-2.43C16.9 3.7 14.85 2.7 12.18 2.7 6.98 2.7 2.75 6.9 2.75 12.2s4.23 9.5 9.43 9.5c5.44 0 9.06-3.82 9.06-9.2 0-.62-.07-1.09-.15-1.4Z" />
				</svg>
				{t.home.recensioniBottone}
			</a>
		</div>
	</section>

	<section class="relative">
		<MappaContatti
			lat={44.6289044}
			lon={11.1968628}
			nomeAttivita={nomeAttivita}
			indirizzo={dati?.indirizzo}
			telefono={dati?.telefono}
			email={dati?.email}
			etichettaTelefono={t.contatti.telefono}
			etichettaEmail={t.contatti.email}
			etichettaSito={t.home.mappaSito}
		/>
		<div class="pointer-events-none absolute inset-0 z-[1100]">
			<div class="relative mx-auto h-full max-w-6xl px-4 sm:px-6">
				<div
					class="pointer-events-auto absolute top-6 right-4 w-[calc(100%-2rem)] max-w-sm rounded-lg bg-amber-700 p-6 shadow-xl sm:right-6 dark:bg-amber-800 dark:shadow-black/40"
				>
					<p class="text-lg font-semibold text-white">{nomeAttivita}</p>
					<p class="mt-3 text-sm text-amber-50">{dati?.indirizzo}</p>
					<p class="mt-1 text-sm text-amber-50">{t.contatti.telefono}: {dati?.telefono}</p>
					<p class="text-sm text-amber-50">{dati?.email}</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
