---
import { getCollection } from 'astro:content';
import ProdottoDettaglio from '../../components/pages/ProdottoDettaglio.astro';

export async function getStaticPaths() {
	const prodotti = await getCollection('prodotti', ({ id }) => id.startsWith('it/'));
	return prodotti.map((prodotto) => ({
		params: { slug: prodotto.id.replace(/^it\//, '') },
		props: { prodotto },
	}));
}

const { prodotto } = Astro.props;
---

<ProdottoDettaglio lang="it" prodotto={prodotto} />
