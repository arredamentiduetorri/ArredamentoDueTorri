---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { rilevaLingua, traduzioni } from '../i18n/utils';

interface Props {
	titolo: string;
	descrizione?: string;
}

const lang = rilevaLingua(Astro.url);
const t = traduzioni(lang);

const { titolo, descrizione = t.meta.descrizione } = Astro.props;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={descrizione} />
		<meta name="generator" content={Astro.generator} />
		<title>{titolo} · Arredamento Due Torri</title>
	</head>
	<body class="flex min-h-screen flex-col bg-cream text-ink">
		<Header lang={lang} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
